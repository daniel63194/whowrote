{
  "id": "openai-codex",
  "name": "OpenAI Codex",
  "vendor": "OpenAI",
  "kind": "ai-agent",
  "url": "https://openai.com/codex",
  "description": "Codex CLI, the Codex IDE extension, and Codex cloud tasks with the ChatGPT Codex connector.",
  "aliases": [
    "codex",
    "openai codex",
    "codex cli"
  ],
  "logins": [
    "chatgpt-codex-connector[bot]"
  ],
  "emails": [
    "noreply@openai.com",
    "codex@openai.com"
  ],
  "names": [],
  "trailers": [],
  "footers": [
    {
      "pattern": "\\bchatgpt\\.com/codex/tasks/task_"
    }
  ],
  "hints": [
    {
      "all": [
        "^codex/"
      ],
      "in": "branch",
      "note": "branch prefix Codex cloud tasks use"
    }
  ],
  "models": [],
  "evidence": [
    "https://developers.openai.com/codex/cloud",
    "https://github.com/getsentry/sentry/commits/master"
  ],
  "examples": [
    {
      "commit": {
        "author": "Jane Doe <jane@example.com>",
        "message": "Fix date parsing\n\nCo-authored-by: Codex <noreply@openai.com>"
      },
      "verdict": "ai-assisted"
    },
    {
      "pullRequest": {
        "author": {
          "login": "janedoe",
          "type": "User"
        },
        "title": "Fix date parsing",
        "body": "## Summary\n- parse ISO weeks\n\n------\nhttps://chatgpt.com/codex/tasks/task_e_68a1b2c3d4"
      },
      "verdict": "ai-assisted"
    },
    {
      "actor": "chatgpt-codex-connector[bot]",
      "verdict": "ai-agent"
    },
    {
      "commit": {
        "author": "Jane Doe <jane@example.com>",
        "message": "Support plaintext agent messages\n\nChild-completion notifications are\ngenerated by Codex itself, so their content is plaintext."
      },
      "verdict": "human"
    },
    {
      "commit": {
        "author": "Jane Doe <jane@example.com>",
        "message": "Bump schema\n\nGenerated by codex-rs/build.rs"
      },
      "verdict": "human"
    },
    {
      "pullRequest": {
        "author": {
          "login": "janedoe",
          "type": "User"
        },
        "branch": "codex/fix-date-parsing",
        "title": "Fix date parsing",
        "body": ""
      },
      "verdict": "human",
      "hint": true
    }
  ]
}
