{
  "id": "claude",
  "name": "Claude",
  "vendor": "Anthropic",
  "kind": "ai-agent",
  "url": "https://claude.com/product/claude-code",
  "description": "Claude Code in the terminal, IDE, desktop and web, and the Claude GitHub app.",
  "aliases": [
    "claude",
    "claude code",
    "anthropic claude"
  ],
  "logins": [
    "claude[bot]"
  ],
  "emails": [
    "noreply@anthropic.com"
  ],
  "names": [
    "^Claude Code\\b",
    "^Claude (?:Opus|Sonnet|Haiku|Fable|Mythos)\\b"
  ],
  "trailers": [
    "Claude-Session"
  ],
  "footers": [
    {
      "pattern": "\\bclaude\\.ai/code/session_"
    }
  ],
  "branches": [
    "^claude/"
  ],
  "files": [
    "**/CLAUDE.md",
    ".claude/**",
    ".mcp.json"
  ],
  "hints": [
    {
      "all": [
        "^#{1,3} ?Summary\\b",
        "^#{1,3} ?Test plan\\b"
      ],
      "note": "Summary and Test plan sections, the layout Claude Code uses by default"
    }
  ],
  "models": [
    "^Claude Code \\((?<model>[^()]+)\\)$",
    "^(?<model>Claude (?:Opus|Sonnet|Haiku|Fable|Mythos)(?: [0-9][0-9.]*)?)"
  ],
  "evidence": [
    "https://code.claude.com/docs/en/settings",
    "https://github.com/apps/claude",
    "https://github.com/PostHog/posthog/commits/master",
    "https://github.com/anthropics/claude-code-action/blob/main/action.yml"
  ],
  "examples": [
